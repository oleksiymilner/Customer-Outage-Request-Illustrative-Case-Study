<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="1162e15" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="Collaboration_1" name="Fix Internet problems">
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_Customer" />
    <bpmn:participant id="Participant_Provider" name="Service Provider" processRef="Process_Provider" />
    <bpmn:messageFlow id="MF_Request" name="Service request" sourceRef="Task_Report" targetRef="Start_Prov" />
    <bpmn:messageFlow id="MF_Done" name="Repair completed" sourceRef="End_Done" targetRef="Catch_Done" />
    <bpmn:messageFlow id="MF_Confirm" name="Confirmation" sourceRef="Task_Confirm" targetRef="Start_Close" />
  </bpmn:collaboration>
  <bpmn:message id="Msg_Request" name="Repair request" />
  <bpmn:message id="Msg_Done" name="Repair completed">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=requestId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_Confirm" name="Confirmation" />
  <bpmn:process id="Process_Customer" isExecutable="false">
    <bpmn:startEvent id="Start_C" name="Problems with INTERNET" />
    <bpmn:task id="Task_Report" name="Report problem with service">
      <bpmn:outgoing>Flow_08igc2u</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Catch_Done" name="Repair completed">
      <bpmn:incoming>Flow_08igc2u</bpmn:incoming>
      <bpmn:messageEventDefinition id="Med_Catch" messageRef="Msg_Done" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_Confirm" name="Confirm completion" />
    <bpmn:sequenceFlow id="SF_C1" sourceRef="Start_C" targetRef="Task_Report" />
    <bpmn:sequenceFlow id="SF_C3" sourceRef="Catch_Done" targetRef="Task_Confirm" />
    <bpmn:sequenceFlow id="SF_C4" sourceRef="Task_Confirm" targetRef="End_C" />
    <bpmn:endEvent id="End_C" name="Request resolved" />
    <bpmn:sequenceFlow id="Flow_08igc2u" name="Waiting for repair" sourceRef="Task_Report" targetRef="Catch_Done" />
  </bpmn:process>
  <bpmn:process id="Process_Provider" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Technician" name="Technician">
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Part</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Followup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Repair</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="DEMO Service">
        <bpmn:flowNodeRef>Task_Close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Closed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0zquv36</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Find</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_NoTech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Close</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dispatcher" name="Dispatcher">
        <bpmn:flowNodeRef>Start_Prov</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_SLA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0wmgjts</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Prov" name="Request received">
      <bpmn:messageEventDefinition id="Med_Start" messageRef="Msg_Request" />
    </bpmn:startEvent>
    <bpmn:endEvent id="End_Done" name="Repair completed">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-customer" />
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="Med_End" messageRef="Msg_Done" />
    </bpmn:endEvent>
    <bpmn:task id="Task_Close" name="Complete activity" />
    <bpmn:endEvent id="End_Closed" name="Request resolved" />
    <bpmn:exclusiveGateway id="GW_Part" name="Spare part missing?" />
    <bpmn:task id="Task_Followup" name="Schedule follow-up visit" />
    <bpmn:task id="Task_Repair" name="Perform repair">
      <bpmn:incoming>SF_10</bpmn:incoming>
      <bpmn:incoming>SF_13</bpmn:incoming>
      <bpmn:outgoing>SF_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Check" name="Check contract / SLA">
      <bpmn:incoming>SF_1</bpmn:incoming>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_SLA" name="SLA valid?">
      <bpmn:outgoing>Flow_0t58yhj</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Reject" name="Reject request, inform customer" />
    <bpmn:endEvent id="End_Rej" name="Request rejected" />
    <bpmn:sequenceFlow id="SF_1" sourceRef="Start_Prov" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="SF_14" name="No" sourceRef="GW_Part" targetRef="End_Done" />
    <bpmn:sequenceFlow id="SF_15" sourceRef="Start_Close" targetRef="Task_Close" />
    <bpmn:sequenceFlow id="SF_16" sourceRef="Task_Close" targetRef="End_Closed" />
    <bpmn:sequenceFlow id="SF_11" sourceRef="Task_Repair" targetRef="GW_Part" />
    <bpmn:sequenceFlow id="SF_12" name="Yes" sourceRef="GW_Part" targetRef="Task_Followup" />
    <bpmn:sequenceFlow id="SF_13" sourceRef="Task_Followup" targetRef="Task_Repair" />
    <bpmn:sequenceFlow id="SF_10" sourceRef="Task_Assign" targetRef="Task_Repair" />
    <bpmn:sequenceFlow id="Flow_0t58yhj" name="Yes" sourceRef="GW_SLA" targetRef="Activity_0zquv36" />
    <bpmn:sequenceFlow id="Flow_0jpxxd9" sourceRef="Activity_0zquv36" targetRef="Task_Find" />
    <bpmn:sequenceFlow id="SF_7" sourceRef="Task_Find" targetRef="Task_Assign" />
    <bpmn:sequenceFlow id="SF_3" sourceRef="Task_Check" targetRef="GW_SLA" />
    <bpmn:sequenceFlow id="SF_5" name="No" sourceRef="GW_SLA" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="SF_6" sourceRef="Task_Reject" targetRef="End_Rej" />
    <bpmn:sequenceFlow id="Flow_08elkmz" sourceRef="Boundary_NoTech" targetRef="Activity_0wmgjts" />
    <bpmn:task id="Activity_0zquv36" name="Create activity in the bucket">
      <bpmn:incoming>Flow_0t58yhj</bpmn:incoming>
      <bpmn:outgoing>Flow_0jpxxd9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Find" name="Find Technician by skill, zone, availability">
      <bpmn:incoming>Flow_0jpxxd9</bpmn:incoming>
    </bpmn:task>
    <bpmn:boundaryEvent id="Boundary_NoTech" name="No Technician in 30 min&#10;Escalate to Dispatcher" attachedToRef="Task_Find">
      <bpmn:outgoing>Flow_08elkmz</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="Task_Assign" name="Reassign activity to Technician">
      <bpmn:incoming>Flow_0bk43he</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_0bk43he" sourceRef="Activity_0wmgjts" targetRef="Task_Assign" />
    <bpmn:startEvent id="Start_Close" name="Customer confirmed">
      <bpmn:outgoing>SF_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_14sfk57" messageRef="Msg_Done" />
    </bpmn:startEvent>
    <bpmn:task id="Activity_0wmgjts" name="Clarify and manually assign to Technician">
      <bpmn:incoming>Flow_08elkmz</bpmn:incoming>
      <bpmn:outgoing>Flow_0bk43he</bpmn:outgoing>
    </bpmn:task>
  </bpmn:process>
